        <include condition="!Window.IsDialogTopMost(gameports) + !Window.IsDialogTopMost(gameagents) + !Window.IsDialogTopMost(gameleaderboards) + !Window.IsDialogTopMost(gameleaderboardentries)">DialogGameControllers</include>
