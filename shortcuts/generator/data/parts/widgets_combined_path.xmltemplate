<variable name="Widget_Combined_Path_{window_id}_{widget_id}">
    <value condition="Integer.IsEqual(Container({widget_category_id}).NumItems,0)" />
    <value condition="!String.IsEmpty(Window.Property(WidgetCombined.{widget_category_id}.Path))">$INFO[Window.Property(WidgetCombined.{widget_category_id}.Path)]</value>
    <!-- Load the first category before the selector receives focus. -->
    <value>$INFO[Container({widget_category_id}).ListItemAbsolute(0).FolderPath]</value>
</variable>
